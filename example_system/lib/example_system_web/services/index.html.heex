<div>
  <%= form_tag("", class: "form", "phx-submit": "add_service") do %>
    <%= text_input(:service, :name, autofocus: true) %>
  <% end %>
</div>

<ul class="paragraph">
  <%= for node <- @nodes do %>
    <li>
      <%= node.name %>
      <ul>
        <%= for service <- node.services do %>
          <li>
            <%= link(service, to: "#", "phx-click": "invoke_#{service}") %>
          </li>
        <% end %>
      </ul>
    </li>
  <% end %>
</ul>

<%= if @response != nil do %>
  <div class="paragraph"><%= @response %></div>
<% end %>
