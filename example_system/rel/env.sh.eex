#!/bin/sh
# Force long-name distribution bound to loopback so the release control
# commands (remote, pid, stop) can reach the running node on hosts whose
# short hostname has no resolvable domain (e.g. macOS dev machines).
: "${RELEASE_DISTRIBUTION:=name}"
: "${RELEASE_NODE:=system@127.0.0.1}"
export RELEASE_DISTRIBUTION RELEASE_NODE
